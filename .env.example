# ---- Server-only secrets (set these in Vercel → Project → Settings → Environment Variables) ----
# Never expose the service role key or the pepper to the browser.

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FLAG_PEPPER=generate-with-openssl-rand-hex-32

# Storage bucket that holds challenge evidence files
CHALLENGE_BUCKET=challenge-files

# ---- Public values (safe to expose; also placed in /public/config.js) ----
# These are duplicated in public/config.js for the browser. Keeping them here documents them.
SUPABASE_ANON_KEY=your-anon-or-publishable-key
